# Dominio di base: unica fonte del dominio nell'intero sistema.
# In sviluppo locale resta "localhost"; il profilo local-prod userà "gestilab.test".
BASE_DOMAIN=localhost

# Porta su cui apps/api resta in ascolto.
API_PORT=3001

# Host su cui apps/api resta in ascolto (0.0.0.0 nei container, 127.0.0.1 in locale nudo).
API_HOST=127.0.0.1

# Stringa di connessione a PostgreSQL (utente applicativo, non owner).
DATABASE_URL=postgres://gestilab:gestilab@localhost:5432/gestilab

# Stringa di connessione a Redis, usata per code e cache.
REDIS_URL=redis://localhost:6379

# Endpoint dello storage S3-compatibile (MinIO in locale).
S3_ENDPOINT=http://localhost:9000

# Bucket S3 in cui vengono salvati allegati e foto.
S3_BUCKET=gestilab-dev

# URL di connessione SMTP per l'invio email (Mailpit in locale).
SMTP_URL=smtp://localhost:1025

# Livello di log del logger strutturato: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info
