# Dominio di base: unica fonte del dominio nell'intero sistema. Usato per
# interpolazione ${BASE_DOMAIN} da Docker Compose stesso (routing Traefik),
# non solo come variabile letta dall'app. In sviluppo locale resta
# "localhost"; il profilo local-prod lo sovrascrive da riga di comando
# ("gestilab.test", vedi script "local-prod" in package.json) senza dover
# toccare questo file. In produzione va impostato qui a "gestilab.it".
BASE_DOMAIN=localhost

# Porta su cui apps/api resta in ascolto.
API_PORT=3001

# Host su cui apps/api resta in ascolto. 0.0.0.0 con "pnpm dev" (Docker);
# 127.0.0.1 se si esegue apps/api fuori da Docker con "pnpm dev:local".
API_HOST=0.0.0.0

# Utente, password e nome del database applicativo in PostgreSQL.
# Usati sia dal container "db" sia per comporre DATABASE_URL qui sotto.
POSTGRES_USER=gestilab
POSTGRES_PASSWORD=gestilab_dev_password
POSTGRES_DB=gestilab

# Stringa di connessione a PostgreSQL usata dall'applicazione: ruolo
# "gestilab_app", non owner (creato dalla migrazione 0000, vedi
# packages/db/migrations). Host "db": nome del servizio Postgres nella rete
# Docker Compose.
DATABASE_URL=postgres://gestilab_app:gestilab_app_dev_password@db:5432/gestilab

# Stringa di connessione con il ruolo owner (POSTGRES_USER sopra): usata
# SOLO dalle migrazioni (packages/db/src/migrate.ts), mai dal codice
# applicativo — vedi docs/02-architettura.md § Isolamento a livello database.
DATABASE_MIGRATE_URL=postgres://gestilab:gestilab_dev_password@db:5432/gestilab

# Connessione applicativa del servizio gestilab-auth-service (repository
# separato, privato — profilo Compose "auth", opzionale): ruolo
# "gestilab_auth", creato dalle migrazioni di quel repository, non da
# questo. Stesso database di DATABASE_URL, credenziali diverse: mai lo
# stesso ruolo per due servizi diversi, anche se scrivono nello stesso
# database (vedi il documento di riferimento, sezione sul servizio auth).
AUTH_DATABASE_URL=postgres://gestilab_auth:gestilab_auth_dev_password@db:5432/gestilab

# Stringa di connessione a Redis, usata per code e cache.
# Host "redis": nome del servizio Redis nella rete Docker Compose.
REDIS_URL=redis://redis:6379

# Endpoint dello storage S3-compatibile (MinIO in locale).
# Host "storage": nome del servizio MinIO nella rete Docker Compose.
S3_ENDPOINT=http://storage:9000

# Bucket S3 in cui vengono salvati allegati e foto.
S3_BUCKET=gestilab-dev

# Credenziali dell'utente root di MinIO (console e API S3).
MINIO_ROOT_USER=gestilab
MINIO_ROOT_PASSWORD=gestilab_dev_password

# URL di connessione SMTP per l'invio email (Mailpit in locale).
# Host "mailpit": nome del servizio Mailpit nella rete Docker Compose.
SMTP_URL=smtp://mailpit:1025

# Livello di log del logger strutturato: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info

# Chiave segreta Django di GlitchTip (error tracking, API compatibile Sentry).
# Solo per sviluppo locale: in produzione va rigenerata e non versionata.
GLITCHTIP_SECRET_KEY=dev-insecure-secret-change-me

# Stringa di connessione al database dedicato di GlitchTip (stesso Postgres
# del servizio "db", database separato da quello applicativo).
GLITCHTIP_DATABASE_URL=postgres://gestilab:gestilab_dev_password@db:5432/glitchtip

# Redis usato da GlitchTip come broker/cache: stesso servizio "redis",
# indice di database diverso (1) per non mescolarsi con le code applicative.
GLITCHTIP_REDIS_URL=redis://redis:6379/1

# URL SMTP usato da GlitchTip per le notifiche via email (Mailpit in locale).
GLITCHTIP_EMAIL_URL=smtp://mailpit:1025

# URL pubblico con cui GlitchTip genera i link nelle notifiche.
GLITCHTIP_DOMAIN=http://localhost:8000

# --- Solo per il profilo prod (compose.prod.yaml), mai eseguito finché non
# --- c'è un dominio registrato e un VPS: vedi "Prerequisiti a spesa" in
# --- docs/07-backlog-mvp.md. Lasciare vuoti fino ad allora.

# Email per le notifiche di scadenza del certificato Let's Encrypt.
ACME_EMAIL=

# Nome del provider DNS usato da Traefik per la sfida DNS-01 (es. il nome
# del provider scelto per il dominio, secondo la documentazione di Traefik
# sui provider DNS supportati). Il provider scelto richiederà anche le
# proprie variabili di autenticazione (token/chiave API): da aggiungere qui
# quando si sceglie il provider, mai versionarle.
DNS_PROVIDER=
