{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["eslint.config.mjs", "apps/web/eslint.config.mjs"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "BASE_DOMAIN",
        "WEB_PROTOCOLLO",
        "WEB_PORTA",
        "API_PORT",
        "API_HOST",
        "DATABASE_URL",
        "DATABASE_MIGRATE_URL",
        "AUTH_SERVICE_URL",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_BUCKET",
        "SMTP_URL",
        "EMAIL_MITTENTE",
        "MAILPIT_API_URL",
        "BACKUP_DIR"
      ]
    }
  }
}
